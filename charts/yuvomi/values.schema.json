{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "yuvomi Helm Chart Values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "volume": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "mountPath": { "type": "string", "pattern": "^/" },
        "size": { "type": "string" },
        "accessModes": {
          "type": "array",
          "items": { "type": "string", "enum": ["ReadWriteOnce", "ReadWriteOncePod", "ReadWriteMany", "ReadOnlyMany"] }
        },
        "storageClass": { "type": "string" },
        "annotations": { "type": "object" },
        "existingClaim": { "type": "string" }
      },
      "required": ["enabled", "mountPath"]
    }
  },
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1,
      "description": "0 or 1 - the SQLite database must only be opened by one pod"
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": { "type": "string" },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" },
        "digest": { "type": "string" }
      },
      "required": ["repository", "pullPolicy"]
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": { "name": { "type": "string" } },
        "required": ["name"]
      }
    },
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "baseUrl": {
      "type": "string",
      "pattern": "^(https?://.+)?$",
      "description": "Public URL (BASE_URL), e.g. https://yuvomi.example.com"
    },
    "timezone": { "type": "string" },
    "sessionSecure": { "type": "boolean" },
    "trustProxy": { "type": ["string", "integer"] },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "issuer": { "type": "string" },
        "redirectUri": { "type": "string" },
        "allowSignup": { "type": "boolean" },
        "allowPasswordLogin": { "type": "boolean" }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "schedule": { "type": "string" },
        "keep": { "type": "integer", "minimum": 1 }
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] },
      "description": "Additional non-secret env vars (rendered into the ConfigMap)"
    },
    "secret": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "values": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "persistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "data": { "$ref": "#/definitions/volume" },
        "backups": { "$ref": "#/definitions/volume" },
        "modules": { "$ref": "#/definitions/volume" },
        "documents": { "$ref": "#/definitions/volume" }
      },
      "required": ["data", "backups", "modules", "documents"]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "annotations": { "type": "object" }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "hosts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "host": { "type": "string" },
              "paths": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string" },
                    "pathType": { "type": "string", "enum": ["Exact", "Prefix", "ImplementationSpecific"] }
                  },
                  "required": ["path"]
                }
              }
            },
            "required": ["host", "paths"]
          }
        },
        "tls": { "type": "array" }
      }
    },
    "gateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": { "type": "array", "items": { "type": "string" } }
      }
    },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "startupProbe": { "type": "object" },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressRules": { "type": "array" },
        "egressRules": { "type": "array" }
      }
    },
    "nodeSelector": { "type": "object" },
    "hostAliases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ip": { "type": "string" },
          "hostnames": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["ip", "hostnames"]
      }
    },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" },
    "extraEnv": { "type": "array" },
    "extraVolumes": { "type": "array" },
    "extraVolumeMounts": { "type": "array" },
    "extraDeploy": { "type": "array" }
  }
}
